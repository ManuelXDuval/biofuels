historical_diesel_prices <- request(paste0(eia_url, "petroleum/pri/gnd/data/")) %>%
req_url_query(
`api_key` = api_key,
`frequency` = "weekly",
`data[0]` = "value",
`facets[product][]` = "EPD2D", # No. 2 Diesel
`facets[area][]` = "NUS",      # U.S. National Average
`sort[0][column]` = "period",
`sort[0][direction]` = "desc",
`length` = 5000                # Set high to pull years of historical data
) %>%
req_perform() %>%
resp_body_json()
